---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import ClientLogoStrip from '../components/ClientLogoStrip.astro';
import { services } from '../data/services';
import { caseStudies } from '../data/caseStudies';

const featuredStudies = caseStudies.slice(0, 2);
---

<BaseLayout
  title="Go-to-Market Engineering Agency"
  description="VORTEX GTM is a Go-to-Market engineering agency that builds revenue infrastructure, demand systems, and pipeline operations for B2B SaaS and AI companies."
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-bloom" aria-hidden="true"></div>
    <div class="container hero-inner">
      <span class="eyebrow hero-eyebrow">// GTM Engineering — operator-grade</span>
      <h1>
        Engineer the GTM motion that <span class="grad">your category leader</span> will spend the next decade copying.
      </h1>
      <p class="hero-lead">
        VORTEX is a specialist agency for B2B SaaS and AI teams. We architect the revenue infrastructure, demand engines, and operating systems that turn growth from a quarterly scramble into a compounding asset.
      </p>
      <div class="hero-ctas">
        <Button href="/contact" variant="primary" size="lg">Book an intro call</Button>
        <Button href="/services" variant="ghost" size="lg">Explore services</Button>
      </div>

      <dl class="hero-stats">
        <div>
          <dt>Avg forecast accuracy lift</dt>
          <dd>+32%</dd>
        </div>
        <div>
          <dt>Pipeline acceleration</dt>
          <dd>2–4×</dd>
        </div>
        <div>
          <dt>CAC payback compression</dt>
          <dd>−47%</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">// What we do</span>
          <h2>Four disciplines. One operating system for revenue.</h2>
        </div>
        <p class="lead">
          We embed alongside your team to ship the foundational systems that compound. Each service stands alone — together they form the engine.
        </p>
      </div>

      <div class="service-grid">
        {services.map((service) => <ServiceCard service={service} />)}
      </div>
    </div>
  </section>

  <!-- CLIENTS -->
  <ClientLogoStrip />

  <!-- FEATURED CASE STUDIES -->
  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">// Selected work</span>
          <h2>What an engineered GTM motion actually delivers.</h2>
        </div>
        <a class="see-all" href="/case-studies">
          All case studies <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="case-grid">
        {featuredStudies.map((study) => <CaseStudyCard study={study} featured />)}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section-dark">
    <div class="container cta-inner">
      <h2>Ready to engineer your next phase of growth?</h2>
      <p class="lead">
        Tell us where you are heading. We will share an honest read on whether VORTEX is the right team to help you get there.
      </p>
      <Button href="/contact" variant="primary" size="lg">Start the conversation</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(5rem, 10vw, 9rem) clamp(4rem, 8vw, 7rem);
    overflow: hidden;
  }
  .hero-bloom {
    position: absolute;
    inset: -10% -10% auto -10%;
    height: 120%;
    background:
      radial-gradient(ellipse 50% 60% at 50% 30%, rgba(0, 87, 255, 0.4) 0%, transparent 60%),
      radial-gradient(ellipse 40% 40% at 30% 50%, rgba(0, 200, 255, 0.18) 0%, transparent 60%),
      radial-gradient(ellipse 35% 45% at 75% 60%, rgba(0, 87, 255, 0.22) 0%, transparent 60%);
    filter: blur(40px);
    z-index: -1;
    pointer-events: none;
    animation: heroBloom 14s var(--ease-out) infinite alternate;
  }
  @keyframes heroBloom {
    0%   { opacity: 0.7; transform: translate(0, 0); }
    50%  { opacity: 1; transform: translate(2%, 2%); }
    100% { opacity: 0.85; transform: translate(-2%, -1%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-bloom { animation: none; }
  }
  .hero-inner {
    max-width: 920px;
    text-align: center;
  }
  .hero-eyebrow {
    color: var(--color-accent);
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: var(--fs-hero);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
    color: var(--color-text);
    text-wrap: balance;
  }
  .grad {
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-lead {
    font-family: var(--font-sans);
    font-size: var(--fs-md);
    line-height: var(--lh-relaxed);
    color: var(--color-text-muted);
    margin: 0 auto 2.25rem;
    max-width: 64ch;
  }
  .hero-ctas {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 4.5rem;
  }
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-border);
    text-align: center;
  }
  .hero-stats dt {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-text-subtle);
    margin-bottom: 0.5rem;
  }
  .hero-stats dd {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: var(--fw-medium);
    color: var(--color-accent);
    letter-spacing: var(--tracking-tight);
    text-shadow: 0 0 30px rgba(0, 200, 255, 0.45);
  }

  .section-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: var(--space-7);
    align-items: end;
  }
  .section-head h2 {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: var(--fw-medium);
    color: var(--color-text);
    max-width: 18ch;
    text-wrap: balance;
  }
  .see-all {
    justify-self: end;
    font-family: var(--font-mono);
    color: var(--color-accent);
    font-weight: var(--fw-medium);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    transition: color var(--transition-base);
  }
  .see-all:hover {
    color: var(--color-accent-hover);
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .case-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .cta-inner {
    text-align: center;
    max-width: 720px;
  }
  .cta-inner h2 {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: var(--fw-medium);
    margin-bottom: 1rem;
    color: var(--color-text);
    text-wrap: balance;
  }
  .cta-inner .lead {
    margin: 0 auto 2rem;
  }

  @media (max-width: 980px) {
    .service-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .case-grid,
    .section-head {
      grid-template-columns: 1fr;
    }
    .see-all {
      justify-self: start;
    }
  }
  @media (max-width: 540px) {
    .service-grid {
      grid-template-columns: 1fr;
    }
    .hero-stats {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
