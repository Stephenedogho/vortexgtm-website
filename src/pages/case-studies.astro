---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { caseStudies } from '../data/caseStudies';
---

<BaseLayout
  title="Case Studies"
  description="See how VORTEX GTM has rebuilt revenue infrastructure, demand systems, and operations for B2B SaaS, AI, and developer-tools companies."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Case Studies</span>
      <h1>Engagements that re-platformed how teams generate revenue.</h1>
      <p class="lead">
        A selection of projects across data, AI, dev-tools, healthcare, and industrial SaaS. Every metric below is post-engagement — measured, not modeled.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="case-grid">
        {caseStudies.map((study) => <CaseStudyCard study={study} />)}
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container cta-inner">
      <h2>Want a deeper walkthrough?</h2>
      <p class="lead">
        We share full architecture diagrams, before/after numbers, and the team makeup behind these engagements under NDA.
      </p>
      <Button href="/contact" variant="primary" size="lg">Request a deep-dive</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-9) var(--space-8);
    background-color: var(--color-off-white);
    background-image: var(--texture-dots);
    background-size: 24px 24px;
    background-repeat: repeat;
    border-bottom: 1px solid var(--color-border);
  }
  .page-hero h1 {
    font-size: var(--fs-3xl);
    color: var(--color-navy);
    margin-bottom: 1rem;
    max-width: 22ch;
  }

  .case-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .cta-inner {
    text-align: center;
    max-width: 700px;
  }
  .cta-inner h2 {
    font-size: var(--fs-2xl);
    margin-bottom: 1rem;
    color: var(--color-white);
  }
  .cta-inner .lead {
    margin: 0 auto 2rem;
  }

  @media (max-width: 820px) {
    .case-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
