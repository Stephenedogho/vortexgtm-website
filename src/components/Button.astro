---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  class: className = '',
} = Astro.props;

const Tag = href ? 'a' : 'button';
const classes = ['btn', `btn-${variant}`, `btn-${size}`, className].filter(Boolean).join(' ');
---

<Tag class={classes} href={href} type={href ? undefined : type}>
  <slot />
  <span class="btn-arrow" aria-hidden="true">→</span>
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-weight: var(--fw-medium);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    border-radius: var(--radius-lg);
    transition:
      background var(--transition-base),
      color var(--transition-base),
      transform var(--transition-base),
      box-shadow var(--transition-base),
      border-color var(--transition-base);
    white-space: nowrap;
    line-height: 1;
    border: 1px solid transparent;
  }
  .btn-md {
    padding: 0.75rem 1.25rem;
  }
  .btn-lg {
    padding: 1rem 1.75rem;
    font-size: var(--fs-sm);
  }
  .btn-arrow {
    display: inline-block;
    transition: transform var(--transition-base);
    font-family: var(--font-sans);
  }
  .btn:hover .btn-arrow {
    transform: translateX(3px);
  }

  .btn-primary {
    background: var(--color-primary);
    color: var(--color-text);
    border-color: var(--color-primary);
    box-shadow: 0 0 0 1px rgba(0, 87, 255, 0.5), 0 8px 24px rgba(0, 87, 255, 0.25);
  }
  .btn-primary:hover {
    background: var(--color-primary-hover);
    transform: translateY(-1px);
    box-shadow:
      0 0 0 1px var(--color-accent),
      0 0 28px rgba(0, 200, 255, 0.55),
      0 12px 32px rgba(0, 87, 255, 0.4);
    border-color: var(--color-accent);
  }

  .btn-secondary {
    background: var(--color-surface);
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }
  .btn-secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    box-shadow: 0 0 24px rgba(0, 200, 255, 0.25);
  }

  .btn-ghost {
    background: transparent;
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }
  .btn-ghost:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: rgba(0, 200, 255, 0.06);
  }
</style>
