---
import type { CaseStudy } from '../data/caseStudies';

interface Props {
  study: CaseStudy;
  featured?: boolean;
}

const { study, featured = false } = Astro.props;
---

<article class:list={['case-card', { featured }]}>
  <div class="case-meta">
    <span class="case-industry">{study.industry}</span>
    <span class="case-client">{study.client}</span>
  </div>
  <h3>{study.headline}</h3>
  <p>{study.summary}</p>

  <ul class="metrics" aria-label={`Key metrics for ${study.client}`}>
    {study.metrics.map((m) => (
      <li>
        <strong>{m.value}</strong>
        <span>{m.label}</span>
      </li>
    ))}
  </ul>

  <div class="case-tags" aria-label="Services applied">
    {study.services.map((s) => <span class="tag">{s}</span>)}
  </div>
</article>

<style>
  .case-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: border-color var(--transition-base), box-shadow var(--transition-base), background var(--transition-base);
    isolation: isolate;
    overflow: hidden;
  }
  .case-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 60% at 100% 0%, rgba(0, 200, 255, 0.10), transparent 60%);
    opacity: 0;
    transition: opacity var(--transition-base);
    z-index: -1;
    pointer-events: none;
  }
  .case-card:hover {
    border-color: var(--color-primary);
    background: var(--color-surface-hover);
    box-shadow: var(--glow-card-hover);
  }
  .case-card:hover::before {
    opacity: 1;
  }
  .case-card.featured {
    border-color: var(--color-border-strong);
    background: linear-gradient(180deg, var(--color-surface-elevated), var(--color-surface));
  }
  .case-card.featured::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
    pointer-events: none;
  }

  .case-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    font-weight: var(--fw-medium);
  }
  .case-industry {
    color: var(--color-accent);
  }
  .case-client {
    color: var(--color-text-subtle);
  }

  .case-card h3 {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: var(--fw-medium);
    line-height: var(--lh-snug);
    color: var(--color-text);
    letter-spacing: var(--tracking-tight);
  }
  .case-card p {
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    padding-block: 1rem;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .metrics li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .metrics strong {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: var(--fw-medium);
    color: var(--color-accent);
    letter-spacing: var(--tracking-tight);
    text-shadow: 0 0 24px rgba(0, 200, 255, 0.4);
  }
  .metrics span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-subtle);
  }

  .case-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-sm);
    background: var(--color-primary-soft);
    color: var(--color-accent);
    border: 1px solid var(--color-border);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
</style>
