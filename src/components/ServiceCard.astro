---
import Icon from './Icon.astro';
import type { Service } from '../data/services';

interface Props {
  service: Service;
  href?: string;
}

const { service, href = `/services#${service.slug}` } = Astro.props;
---

<a class="service-card" href={href}>
  <div class="icon-wrap">
    <Icon name={service.icon} size={26} />
  </div>
  <h3>{service.shortTitle}</h3>
  <p class="card-tagline">{service.tagline}</p>
  <span class="learn-more">
    <span class="learn-text">Learn more</span>
    <span class="learn-arrow" aria-hidden="true">→</span>
  </span>
</a>

<style>
  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition:
      transform var(--transition-base),
      border-color var(--transition-base),
      box-shadow var(--transition-base),
      background var(--transition-base);
    overflow: hidden;
    isolation: isolate;
  }
  .service-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 80% at 50% 0%, rgba(0, 87, 255, 0.18), transparent 60%);
    opacity: 0;
    transition: opacity var(--transition-base);
    z-index: -1;
    pointer-events: none;
  }
  .service-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-primary);
    background: var(--color-surface-hover);
    box-shadow: var(--glow-card-hover);
  }
  .service-card:hover::before {
    opacity: 1;
  }
  .icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--color-primary-soft);
    color: var(--color-accent);
    border: 1px solid var(--color-border);
    transition: color var(--transition-base), border-color var(--transition-base);
  }
  .service-card:hover .icon-wrap {
    color: var(--color-accent-hover);
    border-color: var(--color-border-accent);
  }
  .service-card h3 {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: var(--fw-medium);
    color: var(--color-text);
    letter-spacing: var(--tracking-tight);
  }
  .card-tagline {
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
    flex: 1;
  }
  .learn-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
  }
  .learn-arrow {
    transition: transform var(--transition-base);
  }
  .service-card:hover .learn-arrow {
    transform: translateX(4px);
  }
</style>
