---
import Logo from './Logo.astro';
import { site } from '../data/site';
import { services } from '../data/services';

const year = new Date().getFullYear();

const socialIcons: Record<string, string> = {
  linkedin: 'M4 4h4v16H4zM4 0h4v3H4zM10 8h4v2h.06c.56-1 1.92-2 4-2 4.27 0 5 2.81 5 6.46V20h-4v-6.42c0-1.53 0-3.5-2.13-3.5s-2.46 1.66-2.46 3.39V20h-4z',
  twitter: 'M18 2h3l-7.5 8.57L22 22h-6.83l-5.34-6.99L3.6 22H1l8.04-9.18L1 2h7l4.83 6.39L18 2zm-1.07 18h1.85L7.18 4H5.2l11.73 16z',
  github: 'M12 2C6.48 2 2 6.58 2 12.21c0 4.51 2.87 8.32 6.84 9.67.5.09.69-.22.69-.49v-1.71c-2.78.61-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.49-1.11-1.49-.91-.62.07-.61.07-.61 1 .07 1.53 1.05 1.53 1.05.89 1.55 2.34 1.1 2.91.84.09-.66.35-1.1.63-1.36-2.22-.26-4.55-1.13-4.55-5.04 0-1.11.39-2.02 1.03-2.74-.1-.26-.45-1.3.1-2.7 0 0 .84-.27 2.75 1.05A9.39 9.39 0 0 1 12 6.84c.85.004 1.71.12 2.51.34 1.91-1.32 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.74 0 3.92-2.34 4.78-4.57 5.03.36.32.68.94.68 1.9v2.81c0 .27.18.59.69.49C19.14 20.52 22 16.71 22 12.21 22 6.58 17.52 2 12 2z',
};
---

<footer class="site-footer">
  <div class="footer-divider" aria-hidden="true"></div>
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo variant="light" />
        <p class="footer-tagline">{site.tagline}</p>
        <ul class="social-list" aria-label="Social profiles">
          {site.social.map((s) => (
            <li>
              <a href={s.href} aria-label={s.label} target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  <path d={socialIcons[s.icon]} fill="currentColor" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h4>Services</h4>
        <ul>
          {services.map((s) => (
            <li><a href={`/services#${s.slug}`}>{s.shortTitle}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h4>Company</h4>
        <ul>
          {site.nav.map((n) => (
            <li><a href={n.href}>{n.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h4>Contact</h4>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></li>
          <li>
            {site.address.line1}<br />
            {site.address.city}, {site.address.region} {site.address.postal}
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} VORTEX GTM. All rights reserved.</p>
      <ul class="legal-links">
        {site.legal.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: linear-gradient(180deg, transparent, rgba(7, 20, 40, 0.85));
    color: var(--color-text);
    padding-block: var(--space-9) var(--space-6);
    margin-top: auto;
  }
  .footer-divider {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(92%, 1200px);
    height: 1px;
    background: var(--color-divider);
    pointer-events: none;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: var(--space-7);
    padding-bottom: var(--space-7);
    border-bottom: 1px solid var(--color-border);
  }
  .footer-brand {
    max-width: 360px;
  }
  .footer-tagline {
    margin-top: 1rem;
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
  }
  .social-list {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .social-list a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    background: var(--color-surface);
    transition: color var(--transition-base), border-color var(--transition-base), background var(--transition-base), box-shadow var(--transition-base);
  }
  .social-list a:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: 0 0 16px rgba(0, 200, 255, 0.3);
  }
  .footer-col h4 {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-accent);
    margin-bottom: 1.25rem;
  }
  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .footer-col a,
  .footer-col li {
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    transition: color var(--transition-base);
  }
  .footer-col a:hover {
    color: var(--color-accent);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-5);
    flex-wrap: wrap;
    gap: 1rem;
  }
  .footer-bottom p {
    color: var(--color-text-subtle);
    font-size: var(--fs-xs);
    font-family: var(--font-mono);
  }
  .legal-links {
    display: flex;
    gap: 1.5rem;
  }
  .legal-links a {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-text-subtle);
    transition: color var(--transition-base);
  }
  .legal-links a:hover {
    color: var(--color-accent);
  }
  @media (max-width: 820px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
